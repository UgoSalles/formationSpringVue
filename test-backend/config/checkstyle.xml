<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Règles platform, volontairement rigides. Le formatage est délégué à spring-javaformat ;
     Checkstyle vérifie la sémantique, les pièges de codage et la documentation. -->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- Logs structurés obligatoires : pas de System.out / System.err -->
  <module name="RegexpSingleline">
    <property name="format" value="System\.(out|err)\."/>
    <property name="message" value="System.out/err interdit — utiliser un logger."/>
  </module>

  <module name="LineLength">
    <property name="max" value="150"/>
    <property name="ignorePattern" value="^package.*|^import.*|href|http://|https://"/>
  </module>

  <!-- Javadoc exigée UNIQUEMENT sur les classes *Service : toute autre couche (controllers, DTOs,
       entités, config…) est documentée par les annotations + Swagger. La suppression ci-dessous
       neutralise les contrôles Javadoc partout SAUF dans les fichiers *Service.java. -->
  <module name="SuppressionSingleFilter">
    <property name="checks"
      value="MissingJavadocMethod|JavadocMethod|SummaryJavadoc|JavadocStyle|NonEmptyAtclauseDescription"/>
    <property name="files" value=".*(?&lt;!Service)\.java$"/>
  </module>

  <module name="TreeWalker">
    <!-- Imports -->
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="IllegalImport"/>

    <!-- Nommage -->
    <module name="PackageName"/>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="LocalFinalVariableName"/>
    <module name="ConstantName"/>
    <module name="StaticVariableName"/>
    <module name="CatchParameterName"/>
    <module name="LambdaParameterName"/>
    <module name="ClassTypeParameterName"/>
    <module name="MethodTypeParameterName"/>
    <module name="InterfaceTypeParameterName"/>

    <!-- Blocs & accolades -->
    <module name="NeedBraces"/>
    <module name="LeftCurly"/>
    <module name="RightCurly"/>
    <module name="EmptyBlock">
      <property name="option" value="text"/>
    </module>
    <module name="EmptyCatchBlock"/>
    <module name="AvoidNestedBlocks"/>

    <!-- Pièges de codage -->
    <module name="EmptyStatement"/>
    <module name="EqualsHashCode"/>
    <module name="CovariantEquals"/>
    <module name="EqualsAvoidNull"/>
    <module name="StringLiteralEquality"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="OneStatementPerLine"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="UnnecessaryParentheses"/>
    <module name="MissingSwitchDefault"/>
    <module name="DefaultComesLast"/>
    <module name="FallThrough"/>
    <module name="ModifiedControlVariable"/>
    <module name="NoClone"/>
    <module name="NoFinalizer"/>
    <module name="IllegalThrows"/>
    <module name="PackageDeclaration"/>
    <module name="HiddenField">
      <property name="ignoreConstructorParameter" value="true"/>
      <property name="ignoreSetter" value="true"/>
      <property name="setterCanReturnItsClass" value="true"/>
    </module>

    <!-- Design (HideUtilityClassConstructor volontairement absent : faux positif sur les classes
         @SpringBootApplication / @Configuration qui n'ont que des membres statiques). -->
    <module name="FinalClass"/>
    <module name="MutableException"/>
    <module name="OneTopLevelClass"/>

    <!-- Mise en forme résiduelle non couverte par spring-javaformat -->
    <module name="ModifierOrder"/>
    <module name="RedundantModifier"/>
    <module name="UpperEll"/>
    <module name="ArrayTypeStyle"/>
    <module name="OuterTypeFilename"/>

    <!-- Javadoc des services (scopée par le SuppressionSingleFilter ci-dessus aux *Service.java) :
         toute méthode d'un service doit être documentée (sauf @Override), et la Javadoc doit être propre. -->
    <module name="MissingJavadocMethod">
      <property name="scope" value="private"/>
      <property name="tokens" value="METHOD_DEF"/>
    </module>
    <module name="JavadocMethod"/>
    <module name="SummaryJavadoc"/>
    <module name="JavadocStyle"/>
    <module name="NonEmptyAtclauseDescription"/>
  </module>
</module>
