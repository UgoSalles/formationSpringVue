# Hook géré par le platform — ne pas modifier.
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/stable)
      echo ""
      echo "  Push direct sur $remote_ref interdit."
      echo "  Ouvre une PR depuis dev et fais passer la CI."
      echo ""
      exit 1
      ;;
  esac
done
exit 0
